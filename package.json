{
  "name": "blue-ridge-beer-hub",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "unset:legacy": "node --env-file=.env.local scripts/unset-legacy-fields.ts",
    "main-invariants": "bash scripts/main-invariants.sh",
    "lint": "eslint",
    "drift-check": "bash scripts/drift-check.sh",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "unset:nulls": "node --env-file=.env.local scripts/unset-nulls.ts",
    "complete:home": "node --env-file=.env.local scripts/complete-home-page.ts",
    "typegen": "sanity schema extract --enforce-required-fields && sanity typegen generate",
    "backup": "node --env-file=.env.local scripts/backup.ts",
    "captions": "node --env-file=.env.local scripts/set-gallery-captions.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@rolldown/binding-wasm32-wasi": "^1.2.7",
    "@sanity/client": "^8.4.0",
    "@sanity/image-url": "^2.1.1",
    "@sanity/mutate": "^0.18.1",
    "@sanity/vision": "^6.12.0",
    "@sanity/visual-editing": "^6.1.2",
    "@sanity/visual-editing-csm": "^3.0.18",
    "@vercel/stega": "^1.1.0",
    "marked": "^18.0.12",
    "next": "16.3.4",
    "next-sanity": "^13.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanity": "^6.12.0",
    "styled-components": "^6.5.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "next-sanity": {
      "@sanity/client": "$@sanity/client"
    }
  }
}
